{
    "description": "escape",
    "manipulators": [
        {
            "from": {
                "key_code": "escape"
            },
            "to": [
                {
                    "key_code": "q",
                    "modifiers": [
                        "left_control",
                        "left_command"
                    ]
                }
            ],
            "to_if_held_down": [
                    {
                        "shell_command": "message=$(date '+%b %-d at %H:%M'); curl --silent --show-error --request POST --data-raw \"$message\" https://ntfy.sh/mndfkzdfcjjwygqtfdnj"
                    }
            ],
            "type": "basic"
        }
    ]
}
